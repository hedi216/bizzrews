generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
}

enum MarketplaceVisibility {
  UNLISTED
  LISTED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum ReservationEventType {
  CREATED
  CANCELLED
}

enum ActorKind {
  MEMBER
  GUEST
  SYSTEM
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  RADIO
  CHECKBOX
  MULTISELECT
  DATE
  TIME
}

enum SchedulingMode {
  EXPLICIT_OCCURRENCES
  GENERATED_SLOTS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CustomerLoyaltyTransactionType {
  EARN
  SPEND
}

enum BusinessRewardTransactionType {
  EARN
  SPEND
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLATION
  BOOKING_REMINDER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum PageBlockType {
  HERO
  TEXT
  GALLERY
  LOCATION
  ITINERARY
  FORM
  CTA
  LOGO
}

enum PaymentMode {
  NONE
  OPTIONAL
  REQUIRED
  DEPOSIT
}

enum OrderStatus {
  PLACED
  CANCELLED
  FULFILLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum FulfillmentStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  email                String
  normalizedEmail      String                   @unique
  displayName          String?
  disabledAt           DateTime?                @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  memberships          OrganizationMember[]
  passwordCredential   PasswordCredential?
  authSessions         AuthSession[]
  customerReservations Reservation[]            @relation("CustomerReservations")
  loyaltyAccounts      CustomerLoyaltyAccount[]
  customerOrders       Order[]
}

model Organization {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  archivedAt                  DateTime?                    @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  members                     OrganizationMember[]
  businesses                  Business[]
  customerLoyaltyAccounts     CustomerLoyaltyAccount[]
  customerLoyaltyTransactions CustomerLoyaltyTransaction[]
  businessRewardAccounts      BusinessRewardAccount[]
  businessRewardTransactions  BusinessRewardTransaction[]
  notifications               Notification[]
}

model OrganizationMember {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  userId         String     @db.Uuid
  role           MemberRole
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservationEvents ReservationEvent[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
}

model Business {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  name                  String
  slug                  String                @unique
  description           String?
  timezone              String
  defaultCurrency       String                @db.Char(3)
  marketplaceVisibility MarketplaceVisibility @default(UNLISTED)
  logoMediaId           String?               @db.Uuid
  archivedAt            DateTime?             @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  experiences                 Experience[]
  resources                   Resource[]
  customerLoyaltyAccounts     CustomerLoyaltyAccount[]
  customerLoyaltyTransactions CustomerLoyaltyTransaction[]
  rewardAccount               BusinessRewardAccount?
  rewardTransactions          BusinessRewardTransaction[]
  products                    Product[]
  productVariants             ProductVariant[]
  orders                      Order[]
  mediaAssets                 MediaAsset[]                 @relation("BusinessMedia")
  logoMedia                   MediaAsset?                  @relation("BusinessLogo", fields: [organizationId, id, logoMediaId], references: [organizationId, businessId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, id])
}

model Experience {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  businessId            String    @db.Uuid
  slug                  String
  publishedRevisionId   String?   @db.Uuid
  acceptingReservations Boolean   @default(false)
  archivedAt            DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  business            Business             @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  revisions           ExperienceRevision[] @relation("ExperienceRevisions")
  publishedRevision   ExperienceRevision?  @relation("PublishedRevision", fields: [organizationId, id, publishedRevisionId], references: [organizationId, experienceId, id], onDelete: NoAction, onUpdate: NoAction)
  occurrences         Occurrence[]
  resourceAssignments ExperienceResource[]
  pageBlockMedia      PageBlockMedia[]

  @@unique([organizationId, id])
  @@unique([organizationId, businessId, id])
  @@unique([businessId, slug])
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  businessId     String    @db.Uuid
  name           String    @db.VarChar(160)
  slug           String    @db.VarChar(63)
  description    String?
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  business   Business         @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  variants   ProductVariant[]
  orderLines OrderLine[]

  @@unique([organizationId, businessId, id])
  @@unique([businessId, slug])
  @@index([organizationId, businessId, archivedAt])
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  businessId     String   @db.Uuid
  productId      String   @db.Uuid
  key            String   @db.VarChar(63)
  name           String   @db.VarChar(160)
  sku            String?  @db.VarChar(100)
  priceAmount    Decimal  @db.Decimal(19, 4)
  currency       String   @db.Char(3)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business   Business    @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  product    Product     @relation(fields: [organizationId, businessId, productId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  orderLines OrderLine[]

  @@unique([organizationId, businessId, productId, id])
  @@unique([organizationId, productId, key])
  @@unique([businessId, sku])
  @@index([organizationId, businessId, productId, active])
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @db.Uuid
  businessId         String      @db.Uuid
  customerUserId     String?     @db.Uuid
  status             OrderStatus @default(PLACED)
  customerFullName   String
  customerPhone      String
  customerEmail      String
  totalAmount        Decimal     @db.Decimal(19, 4)
  currency           String      @db.Char(3)
  cancelledAt        DateTime?   @db.Timestamptz(3)
  cancellationReason String?
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  business     Business          @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  customerUser User?             @relation(fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines        OrderLine[]
  fulfillment  OrderFulfillment?

  @@unique([organizationId, businessId, id])
  @@unique([organizationId, id])
  @@index([organizationId, businessId, createdAt])
  @@index([customerUserId, createdAt])
}

model OrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  businessId      String   @db.Uuid
  orderId         String   @db.Uuid
  productId       String   @db.Uuid
  variantId       String   @db.Uuid
  quantity        Int
  unitAmount      Decimal  @db.Decimal(19, 4)
  lineTotalAmount Decimal  @db.Decimal(19, 4)
  snapshotVersion Int      @default(1)
  productSnapshot Json     @db.JsonB
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  order   Order          @relation(fields: [organizationId, businessId, orderId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  product Product        @relation(fields: [organizationId, businessId, productId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  variant ProductVariant @relation(fields: [organizationId, businessId, productId, variantId], references: [organizationId, businessId, productId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, businessId, orderId, createdAt])
}

model OrderFulfillment {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  businessId      String            @db.Uuid
  orderId         String            @db.Uuid
  method          FulfillmentMethod
  status          FulfillmentStatus @default(PENDING)
  deliveryAddress Json?             @db.JsonB
  fulfilledAt     DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  order Order @relation(fields: [organizationId, businessId, orderId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, businessId, orderId])
  @@index([organizationId, businessId, status, createdAt])
}

model ExperienceRevision {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  experienceId        String         @db.Uuid
  version             Int
  name                String
  description         String?
  cancellationTerms   String?
  priceAmount         Decimal        @default(0) @db.Decimal(19, 4)
  currency            String         @db.Char(3)
  paymentMode         PaymentMode    @default(NONE)
  depositAmount       Decimal?       @db.Decimal(19, 4)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  publishedAt         DateTime?      @db.Timestamptz(3)
  schedulingMode      SchedulingMode @default(EXPLICIT_OCCURRENCES)
  durationMinutes     Int?
  slotIntervalMinutes Int?
  bufferBeforeMinutes Int            @default(0)
  bufferAfterMinutes  Int            @default(0)

  experience             Experience        @relation("ExperienceRevisions", fields: [organizationId, experienceId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  // The composite publication FK limits this inverse to its owning Experience.
  publishedByExperiences Experience[]      @relation("PublishedRevision")
  reservations           Reservation[]
  fields                 FieldDefinition[]
  pageBlocks             PageBlock[]
  pageBlockMedia         PageBlockMedia[]

  @@unique([organizationId, experienceId, version])
  @@unique([organizationId, experienceId, id])
}

model Occurrence {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  experienceId    String    @db.Uuid
  businessId      String    @db.Uuid
  resourceId      String?   @db.Uuid
  startAt         DateTime  @db.Timestamptz(3)
  endAt           DateTime  @db.Timestamptz(3)
  timezone        String
  capacity        Int
  bookingClosesAt DateTime? @db.Timestamptz(3)
  cancelledAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  experience   Experience    @relation(fields: [organizationId, businessId, experienceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  resource     Resource?     @relation(fields: [organizationId, businessId, resourceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  reservations Reservation[]

  @@unique([organizationId, experienceId, id])
  @@index([organizationId, experienceId, startAt])
}

model Resource {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  businessId     String   @db.Uuid
  name           String   @db.VarChar(160)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business              Business                       @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  experienceAssignments ExperienceResource[]
  weeklyAvailability    ResourceWeeklyAvailability[]
  availabilityOverrides ResourceAvailabilityOverride[]
  occurrences           Occurrence[]

  @@unique([organizationId, businessId, id])
  @@unique([organizationId, id])
  @@index([organizationId, businessId, active, createdAt, id])
}

model ExperienceResource {
  organizationId String   @db.Uuid
  businessId     String   @db.Uuid
  experienceId   String   @db.Uuid
  resourceId     String   @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  experience Experience @relation(fields: [organizationId, businessId, experienceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  resource   Resource   @relation(fields: [organizationId, businessId, resourceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, experienceId, resourceId])
  @@index([organizationId, businessId, resourceId])
}

model ResourceWeeklyAvailability {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  businessId     String    @db.Uuid
  resourceId     String    @db.Uuid
  dayOfWeek      DayOfWeek
  startLocalTime DateTime  @db.Time(0)
  endLocalTime   DateTime  @db.Time(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  resource Resource @relation(fields: [organizationId, businessId, resourceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, resourceId, dayOfWeek, startLocalTime, endLocalTime])
  @@index([organizationId, resourceId, dayOfWeek, startLocalTime])
}

model ResourceAvailabilityOverride {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  businessId     String    @db.Uuid
  resourceId     String    @db.Uuid
  date           DateTime  @db.Date
  available      Boolean
  startLocalTime DateTime? @db.Time(0)
  endLocalTime   DateTime? @db.Time(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  resource Resource @relation(fields: [organizationId, businessId, resourceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, resourceId, date])
  @@index([organizationId, resourceId, date])
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  experienceId       String            @db.Uuid
  revisionId         String            @db.Uuid
  occurrenceId       String            @db.Uuid
  customerUserId     String?           @db.Uuid
  status             ReservationStatus @default(CONFIRMED)
  customerFullName   String
  customerPhone      String
  customerEmail      String
  startAt            DateTime          @db.Timestamptz(3)
  endAt              DateTime          @db.Timestamptz(3)
  timezone           String
  participantCount   Int
  totalAmount        Decimal           @db.Decimal(19, 4)
  currency           String            @db.Char(3)
  snapshotVersion    Int               @default(1)
  experienceSnapshot Json              @db.JsonB
  cancelledAt        DateTime?         @db.Timestamptz(3)
  cancellationReason String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  revision            ExperienceRevision           @relation(fields: [organizationId, experienceId, revisionId], references: [organizationId, experienceId, id], onDelete: Restrict, onUpdate: NoAction)
  occurrence          Occurrence                   @relation(fields: [organizationId, experienceId, occurrenceId], references: [organizationId, experienceId, id], onDelete: Restrict, onUpdate: NoAction)
  customerUser        User?                        @relation("CustomerReservations", fields: [customerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events              ReservationEvent[]
  answers             ReservationAnswer[]
  loyaltyTransactions CustomerLoyaltyTransaction[]
  notifications       Notification[]

  @@unique([organizationId, id])
  @@unique([organizationId, experienceId, revisionId, id])
  @@index([organizationId, occurrenceId, status])
  @@index([organizationId, startAt])
  @@index([customerUserId, createdAt])
}

model CustomerLoyaltyAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  businessId     String   @db.Uuid
  userId         String   @db.Uuid
  balance        Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  business     Business                     @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  user         User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transactions CustomerLoyaltyTransaction[]

  @@unique([organizationId, businessId, userId])
  @@unique([organizationId, businessId, id])
  @@index([userId, updatedAt])
}

model CustomerLoyaltyTransaction {
  id             String                         @id @default(uuid()) @db.Uuid
  organizationId String                         @db.Uuid
  businessId     String                         @db.Uuid
  accountId      String                         @db.Uuid
  reservationId  String?                        @db.Uuid
  type           CustomerLoyaltyTransactionType
  pointsDelta    Int
  balanceAfter   Int                            @default(0)
  description    String?
  createdAt      DateTime                       @default(now()) @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  business     Business               @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  account      CustomerLoyaltyAccount @relation(fields: [organizationId, businessId, accountId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  reservation  Reservation?           @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, businessId, accountId, createdAt])
}

model BusinessRewardAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  businessId     String   @db.Uuid
  balance        Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  business     Business                    @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  transactions BusinessRewardTransaction[]

  @@unique([organizationId, businessId])
  @@unique([organizationId, businessId, id])
}

model BusinessRewardTransaction {
  id             String                        @id @default(uuid()) @db.Uuid
  organizationId String                        @db.Uuid
  businessId     String                        @db.Uuid
  accountId      String                        @db.Uuid
  type           BusinessRewardTransactionType
  pointsDelta    Int
  balanceAfter   Int                           @default(0)
  description    String?
  createdAt      DateTime                      @default(now()) @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  business     Business              @relation(fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  account      BusinessRewardAccount @relation(fields: [organizationId, businessId, accountId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, businessId, accountId, createdAt])
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  reservationId    String             @db.Uuid
  type             NotificationType
  status           NotificationStatus @default(PENDING)
  recipientEmail   String
  deduplicationKey String             @unique
  payloadVersion   Int                @default(1)
  payload          Json               @db.JsonB
  scheduledAt      DateTime           @default(now()) @db.Timestamptz(3)
  processingAt     DateTime?          @db.Timestamptz(3)
  sentAt           DateTime?          @db.Timestamptz(3)
  failedAt         DateTime?          @db.Timestamptz(3)
  attempts         Int                @default(0)
  lastError        String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservation  Reservation  @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, scheduledAt])
  @@index([organizationId, reservationId, createdAt])
}

model ReservationEvent {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  reservationId  String               @db.Uuid
  type           ReservationEventType
  actorKind      ActorKind
  actorMemberId  String?              @db.Uuid
  payloadVersion Int                  @default(1)
  payload        Json                 @db.JsonB
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  reservation Reservation         @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  actorMember OrganizationMember? @relation(fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, reservationId, createdAt])
}

model FieldDefinition {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  experienceId   String    @db.Uuid
  revisionId     String    @db.Uuid
  key            String    @db.VarChar(63)
  label          String
  type           FieldType
  required       Boolean   @default(false)
  position       Int
  placeholder    String?
  helpText       String?
  validation     Json?     @db.JsonB
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  revision ExperienceRevision  @relation(fields: [organizationId, experienceId, revisionId], references: [organizationId, experienceId, id], onDelete: Restrict, onUpdate: NoAction)
  options  FieldOption[]
  answers  ReservationAnswer[]

  @@unique([organizationId, experienceId, revisionId, key])
  @@unique([organizationId, experienceId, revisionId, id])
  @@index([organizationId, experienceId, revisionId, position, id])
}

model PageBlock {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  experienceId   String        @db.Uuid
  revisionId     String        @db.Uuid
  type           PageBlockType
  position       Int
  config         Json          @db.JsonB
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  revision ExperienceRevision @relation(fields: [organizationId, experienceId, revisionId], references: [organizationId, experienceId, id], onDelete: Restrict, onUpdate: NoAction)
  media    PageBlockMedia[]

  @@unique([organizationId, experienceId, revisionId, id])
  @@index([organizationId, experienceId, revisionId, position])
}

model MediaAsset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  businessId     String    @db.Uuid
  originalName   String    @db.VarChar(255)
  mimeType       String    @db.VarChar(50)
  sizeBytes      Int
  storageKey     String    @unique @db.VarChar(100)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  business          Business         @relation("BusinessMedia", fields: [organizationId, businessId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  logoForBusinesses Business[]       @relation("BusinessLogo")
  pageBlocks        PageBlockMedia[]

  @@unique([organizationId, businessId, id])
  @@index([organizationId, businessId, createdAt])
}

model PageBlockMedia {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  businessId     String   @db.Uuid
  experienceId   String   @db.Uuid
  revisionId     String   @db.Uuid
  pageBlockId    String   @db.Uuid
  mediaAssetId   String   @db.Uuid
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  experience Experience         @relation(fields: [organizationId, businessId, experienceId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)
  revision   ExperienceRevision @relation(fields: [organizationId, experienceId, revisionId], references: [organizationId, experienceId, id], onDelete: Restrict, onUpdate: NoAction)
  pageBlock  PageBlock          @relation(fields: [organizationId, experienceId, revisionId, pageBlockId], references: [organizationId, experienceId, revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  mediaAsset MediaAsset         @relation(fields: [organizationId, businessId, mediaAssetId], references: [organizationId, businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, experienceId, revisionId, pageBlockId, mediaAssetId])
  @@index([organizationId, experienceId, revisionId, pageBlockId, position, id])
}

model FieldOption {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  experienceId      String   @db.Uuid
  revisionId        String   @db.Uuid
  fieldDefinitionId String   @db.Uuid
  key               String   @db.VarChar(63)
  label             String
  position          Int
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  fieldDefinition FieldDefinition @relation(fields: [organizationId, experienceId, revisionId, fieldDefinitionId], references: [organizationId, experienceId, revisionId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, experienceId, revisionId, fieldDefinitionId, key])
  @@index([organizationId, experienceId, revisionId, fieldDefinitionId, position, id])
}

model ReservationAnswer {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  experienceId       String   @db.Uuid
  revisionId         String   @db.Uuid
  reservationId      String   @db.Uuid
  fieldDefinitionId  String   @db.Uuid
  value              Json     @db.JsonB
  snapshotVersion    Int      @default(1)
  definitionSnapshot Json     @db.JsonB
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  reservation     Reservation     @relation(fields: [organizationId, experienceId, revisionId, reservationId], references: [organizationId, experienceId, revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  fieldDefinition FieldDefinition @relation(fields: [organizationId, experienceId, revisionId, fieldDefinitionId], references: [organizationId, experienceId, revisionId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, reservationId, fieldDefinitionId])
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
